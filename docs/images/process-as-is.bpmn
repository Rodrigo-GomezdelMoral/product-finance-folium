<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="process-as-is" targetNamespace="https://github.com/Rodrigo-GomezdelMoral/product-finance-folium"><bpmn:collaboration id="collaboration"><bpmn:participant id="vendors" name="Vendors"/><bpmn:participant id="distributor" name="Distributor" processRef="process"/><bpmn:messageFlow id="message_vendors_received" name="PDF or scan" sourceRef="vendors" targetRef="received"/></bpmn:collaboration><bpmn:process id="process" isExecutable="false"><bpmn:laneSet id="lanes"><bpmn:lane id="clerk" name="Accounts payable clerk"><bpmn:flowNodeRef>received</bpmn:flowNodeRef><bpmn:flowNodeRef>receive</bpmn:flowNodeRef><bpmn:flowNodeRef>read</bpmn:flowNodeRef><bpmn:flowNodeRef>vendor</bpmn:flowNodeRef><bpmn:flowNodeRef>header</bpmn:flowNodeRef><bpmn:flowNodeRef>lines</bpmn:flowNodeRef><bpmn:flowNodeRef>totals</bpmn:flowNodeRef><bpmn:flowNodeRef>duplicates</bpmn:flowNodeRef><bpmn:flowNodeRef>file</bpmn:flowNodeRef><bpmn:flowNodeRef>entered</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="received" name="Received"><bpmn:outgoing>flow_received_receive</bpmn:outgoing><bpmn:messageEventDefinition id="received_message"/></bpmn:startEvent><bpmn:userTask id="receive" name="Receive invoice (1 min)"><bpmn:incoming>flow_received_receive</bpmn:incoming><bpmn:outgoing>flow_receive_read</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="read" name="Open and read it (1-2 min)"><bpmn:incoming>flow_receive_read</bpmn:incoming><bpmn:outgoing>flow_read_vendor</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="vendor" name="Look up vendor (in the ERP · 1-2 min)"><bpmn:incoming>flow_read_vendor</bpmn:incoming><bpmn:outgoing>flow_vendor_header</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="header" name="Key header fields (2-4 min)"><bpmn:incoming>flow_vendor_header</bpmn:incoming><bpmn:outgoing>flow_header_lines</bpmn:outgoing><bpmn:dataOutputAssociation id="write_header_erp"><bpmn:targetRef>erp</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask><bpmn:userTask id="lines" name="Key line items (2-6 min)"><bpmn:incoming>flow_header_lines</bpmn:incoming><bpmn:outgoing>flow_lines_totals</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="totals" name="Check totals, VAT (by hand · 1-2 min)"><bpmn:incoming>flow_lines_totals</bpmn:incoming><bpmn:outgoing>flow_totals_duplicates</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="duplicates" name="Search duplicates (in the ERP · 0.5-1 min)"><bpmn:incoming>flow_totals_duplicates</bpmn:incoming><bpmn:outgoing>flow_duplicates_file</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="file" name="File the PDF (note the entry · 0.5-1 min)"><bpmn:incoming>flow_duplicates_file</bpmn:incoming><bpmn:outgoing>flow_file_entered</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="entered" name="Entry in the ERP"><bpmn:incoming>flow_file_entered</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="flow_received_receive" sourceRef="received" targetRef="receive"/><bpmn:sequenceFlow id="flow_receive_read" sourceRef="receive" targetRef="read"/><bpmn:sequenceFlow id="flow_read_vendor" sourceRef="read" targetRef="vendor"/><bpmn:sequenceFlow id="flow_vendor_header" sourceRef="vendor" targetRef="header"/><bpmn:sequenceFlow id="flow_header_lines" sourceRef="header" targetRef="lines"/><bpmn:sequenceFlow id="flow_lines_totals" sourceRef="lines" targetRef="totals"/><bpmn:sequenceFlow id="flow_totals_duplicates" sourceRef="totals" targetRef="duplicates"/><bpmn:sequenceFlow id="flow_duplicates_file" sourceRef="duplicates" targetRef="file"/><bpmn:sequenceFlow id="flow_file_entered" sourceRef="file" targetRef="entered"/><bpmn:dataStoreReference id="erp" name="ERP"/><bpmn:textAnnotation id="late"><bpmn:text>Duplicates and wrong tax lines surface weeks later</bpmn:text></bpmn:textAnnotation><bpmn:association id="late_link" sourceRef="duplicates" targetRef="late"/></bpmn:process><bpmndi:BPMNDiagram id="diagram"><bpmndi:BPMNPlane id="plane" bpmnElement="collaboration"><bpmndi:BPMNShape id="vendors_di" bpmnElement="vendors" isHorizontal="true"><dc:Bounds x="40" y="40" width="1560" height="90"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="distributor_di" bpmnElement="distributor" isHorizontal="true"><dc:Bounds x="40" y="170" width="1560" height="590"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="clerk_di" bpmnElement="clerk" isHorizontal="true"><dc:Bounds x="88" y="170" width="1512" height="590"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="received_di" bpmnElement="received"><dc:Bounds x="150" y="295" width="40" height="40"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="receive_di" bpmnElement="receive"><dc:Bounds x="240" y="250" width="270" height="130"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="read_di" bpmnElement="read"><dc:Bounds x="540" y="250" width="270" height="130"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="vendor_di" bpmnElement="vendor"><dc:Bounds x="840" y="250" width="270" height="130"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="header_di" bpmnElement="header"><dc:Bounds x="1140" y="250" width="270" height="130"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="lines_di" bpmnElement="lines"><dc:Bounds x="240" y="490" width="270" height="130"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="totals_di" bpmnElement="totals"><dc:Bounds x="540" y="490" width="270" height="130"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="duplicates_di" bpmnElement="duplicates"><dc:Bounds x="840" y="490" width="270" height="130"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="file_di" bpmnElement="file"><dc:Bounds x="1140" y="490" width="270" height="130"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="entered_di" bpmnElement="entered"><dc:Bounds x="1500" y="535" width="40" height="40"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="erp_di" bpmnElement="erp"><dc:Bounds x="1504" y="293" width="52" height="44"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="late_di" bpmnElement="late"><dc:Bounds x="1010" y="660" width="520" height="56"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="message_vendors_received_di" bpmnElement="message_vendors_received"><di:waypoint x="170" y="130"/><di:waypoint x="170" y="295"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="flow_received_receive_di" bpmnElement="flow_received_receive"><di:waypoint x="190" y="315"/><di:waypoint x="240" y="315"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="flow_receive_read_di" bpmnElement="flow_receive_read"><di:waypoint x="510" y="315"/><di:waypoint x="540" y="315"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="flow_read_vendor_di" bpmnElement="flow_read_vendor"><di:waypoint x="810" y="315"/><di:waypoint x="840" y="315"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="flow_vendor_header_di" bpmnElement="flow_vendor_header"><di:waypoint x="1110" y="315"/><di:waypoint x="1140" y="315"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="flow_header_lines_di" bpmnElement="flow_header_lines"><di:waypoint x="1275" y="380"/><di:waypoint x="1275" y="435"/><di:waypoint x="375" y="435"/><di:waypoint x="375" y="490"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="flow_lines_totals_di" bpmnElement="flow_lines_totals"><di:waypoint x="510" y="555"/><di:waypoint x="540" y="555"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="flow_totals_duplicates_di" bpmnElement="flow_totals_duplicates"><di:waypoint x="810" y="555"/><di:waypoint x="840" y="555"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="flow_duplicates_file_di" bpmnElement="flow_duplicates_file"><di:waypoint x="1110" y="555"/><di:waypoint x="1140" y="555"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="flow_file_entered_di" bpmnElement="flow_file_entered"><di:waypoint x="1410" y="555"/><di:waypoint x="1500" y="555"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="write_header_erp_di" bpmnElement="write_header_erp"><di:waypoint x="1410" y="315"/><di:waypoint x="1504" y="315"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="late_link_di" bpmnElement="late_link"><di:waypoint x="975" y="620"/><di:waypoint x="975" y="688"/><di:waypoint x="1010" y="688"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>
