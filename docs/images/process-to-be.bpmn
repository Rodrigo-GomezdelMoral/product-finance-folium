<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="process-to-be" targetNamespace="https://github.com/Rodrigo-GomezdelMoral/product-finance-folium"><bpmn:collaboration id="collaboration"><bpmn:participant id="vendors" name="Vendors"/><bpmn:participant id="distributor" name="Distributor" processRef="process"/><bpmn:messageFlow id="message_vendors_received" name="PDF or scan" sourceRef="vendors" targetRef="received"/></bpmn:collaboration><bpmn:process id="process" isExecutable="false"><bpmn:laneSet id="lanes"><bpmn:lane id="clerk" name="Accounts payable clerk"><bpmn:flowNodeRef>received</bpmn:flowNodeRef><bpmn:flowNodeRef>upload</bpmn:flowNodeRef><bpmn:flowNodeRef>review</bpmn:flowNodeRef><bpmn:flowNodeRef>clean</bpmn:flowNodeRef><bpmn:flowNodeRef>approve</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="folium" name="Folium"><bpmn:flowNodeRef>extract</bpmn:flowNodeRef><bpmn:flowNodeRef>normalise</bpmn:flowNodeRef><bpmn:flowNodeRef>validate</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lead" name="Accounting lead"><bpmn:flowNodeRef>resolve</bpmn:flowNodeRef><bpmn:flowNodeRef>export</bpmn:flowNodeRef><bpmn:flowNodeRef>exported</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="received" name="Received"><bpmn:outgoing>flow_received_upload</bpmn:outgoing><bpmn:messageEventDefinition id="received_message"/></bpmn:startEvent><bpmn:userTask id="upload" name="Upload a batch (up to 20 files)"><bpmn:incoming>flow_received_upload</bpmn:incoming><bpmn:outgoing>flow_upload_extract</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="review" name="Review and correct (target ≤ 2 min)"><bpmn:incoming>flow_validate_review</bpmn:incoming><bpmn:outgoing>flow_review_clean</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="clean" name="Any finding?"><bpmn:incoming>flow_review_clean</bpmn:incoming><bpmn:outgoing>flow_clean_approve</bpmn:outgoing><bpmn:outgoing>flow_clean_resolve</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="approve" name="Approve (clean invoices only)"><bpmn:incoming>flow_clean_approve</bpmn:incoming><bpmn:outgoing>flow_approve_export</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="extract" name="Extract fields (Document Intelligence)"><bpmn:incoming>flow_upload_extract</bpmn:incoming><bpmn:outgoing>flow_extract_normalise</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="normalise" name="Normalise (and match the vendor)"><bpmn:incoming>flow_extract_normalise</bpmn:incoming><bpmn:outgoing>flow_normalise_validate</bpmn:outgoing><bpmn:property id="normalise_input" name="__targetRef_placeholder"/><bpmn:dataInputAssociation id="read_vendor_master_normalise"><bpmn:sourceRef>vendor_master</bpmn:sourceRef><bpmn:targetRef>normalise_input</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:serviceTask><bpmn:serviceTask id="validate" name="Validate (and check duplicates)"><bpmn:incoming>flow_normalise_validate</bpmn:incoming><bpmn:outgoing>flow_validate_review</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="resolve" name="Resolve and approve (findings, duplicates)"><bpmn:incoming>flow_clean_resolve</bpmn:incoming><bpmn:outgoing>flow_resolve_export</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="export" name="Export (exactly once)"><bpmn:incoming>flow_approve_export</bpmn:incoming><bpmn:incoming>flow_resolve_export</bpmn:incoming><bpmn:outgoing>flow_export_exported</bpmn:outgoing><bpmn:dataOutputAssociation id="write_export_erp_file"><bpmn:targetRef>erp_file</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask><bpmn:endEvent id="exported" name="Exported"><bpmn:incoming>flow_export_exported</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="flow_received_upload" sourceRef="received" targetRef="upload"/><bpmn:sequenceFlow id="flow_upload_extract" sourceRef="upload" targetRef="extract"/><bpmn:sequenceFlow id="flow_extract_normalise" sourceRef="extract" targetRef="normalise"/><bpmn:sequenceFlow id="flow_normalise_validate" sourceRef="normalise" targetRef="validate"/><bpmn:sequenceFlow id="flow_validate_review" sourceRef="validate" targetRef="review"/><bpmn:sequenceFlow id="flow_review_clean" sourceRef="review" targetRef="clean"/><bpmn:sequenceFlow id="flow_clean_approve" name="none" sourceRef="clean" targetRef="approve"/><bpmn:sequenceFlow id="flow_clean_resolve" name="finding or duplicate" sourceRef="clean" targetRef="resolve"/><bpmn:sequenceFlow id="flow_approve_export" sourceRef="approve" targetRef="export"/><bpmn:sequenceFlow id="flow_resolve_export" sourceRef="resolve" targetRef="export"/><bpmn:sequenceFlow id="flow_export_exported" sourceRef="export" targetRef="exported"/><bpmn:dataStoreReference id="vendor_master" name="Vendor master"/><bpmn:dataObject id="erp_file_object"/><bpmn:dataObjectReference id="erp_file" name="ERP file: CSV, JSON" dataObjectRef="erp_file_object"/><bpmn:textAnnotation id="never"><bpmn:text>Never approves or exports</bpmn:text></bpmn:textAnnotation></bpmn:process><bpmndi:BPMNDiagram id="diagram"><bpmndi:BPMNPlane id="plane" bpmnElement="collaboration"><bpmndi:BPMNShape id="vendors_di" bpmnElement="vendors" isHorizontal="true"><dc:Bounds x="40" y="40" width="1640" height="90"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="distributor_di" bpmnElement="distributor" isHorizontal="true"><dc:Bounds x="40" y="170" width="1640" height="820"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="clerk_di" bpmnElement="clerk" isHorizontal="true"><dc:Bounds x="88" y="170" width="1592" height="270"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="folium_di" bpmnElement="folium" isHorizontal="true"><dc:Bounds x="88" y="440" width="1592" height="220"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="lead_di" bpmnElement="lead" isHorizontal="true"><dc:Bounds x="88" y="660" width="1592" height="330"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="received_di" bpmnElement="received"><dc:Bounds x="150" y="280" width="40" height="40"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="upload_di" bpmnElement="upload"><dc:Bounds x="230" y="235" width="240" height="130"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="review_di" bpmnElement="review"><dc:Bounds x="850" y="235" width="260" height="130"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="clean_di" bpmnElement="clean" isMarkerVisible="true"><dc:Bounds x="1150" y="270" width="60" height="60"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="approve_di" bpmnElement="approve"><dc:Bounds x="1360" y="235" width="240" height="130"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="extract_di" bpmnElement="extract"><dc:Bounds x="230" y="485" width="240" height="130"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="normalise_di" bpmnElement="normalise"><dc:Bounds x="550" y="485" width="240" height="130"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="validate_di" bpmnElement="validate"><dc:Bounds x="850" y="485" width="260" height="130"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="resolve_di" bpmnElement="resolve"><dc:Bounds x="1050" y="745" width="260" height="130"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="export_di" bpmnElement="export"><dc:Bounds x="1380" y="745" width="200" height="130"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="exported_di" bpmnElement="exported"><dc:Bounds x="1620" y="790" width="40" height="40"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="vendor_master_di" bpmnElement="vendor_master"><dc:Bounds x="644" y="703" width="52" height="44"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="erp_file_di" bpmnElement="erp_file"><dc:Bounds x="1462" y="902" width="36" height="46"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="never_di" bpmnElement="never"><dc:Bounds x="1212" y="528" width="228" height="56"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="message_vendors_received_di" bpmnElement="message_vendors_received"><di:waypoint x="170" y="130"/><di:waypoint x="170" y="280"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="flow_received_upload_di" bpmnElement="flow_received_upload"><di:waypoint x="190" y="300"/><di:waypoint x="230" y="300"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="flow_upload_extract_di" bpmnElement="flow_upload_extract"><di:waypoint x="350" y="365"/><di:waypoint x="350" y="485"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="flow_extract_normalise_di" bpmnElement="flow_extract_normalise"><di:waypoint x="470" y="550"/><di:waypoint x="550" y="550"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="flow_normalise_validate_di" bpmnElement="flow_normalise_validate"><di:waypoint x="790" y="550"/><di:waypoint x="850" y="550"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="flow_validate_review_di" bpmnElement="flow_validate_review"><di:waypoint x="980" y="485"/><di:waypoint x="980" y="365"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="flow_review_clean_di" bpmnElement="flow_review_clean"><di:waypoint x="1110" y="300"/><di:waypoint x="1150" y="300"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="flow_clean_approve_di" bpmnElement="flow_clean_approve"><di:waypoint x="1210" y="300"/><di:waypoint x="1360" y="300"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="flow_clean_resolve_di" bpmnElement="flow_clean_resolve"><di:waypoint x="1180" y="330"/><di:waypoint x="1180" y="745"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="flow_approve_export_di" bpmnElement="flow_approve_export"><di:waypoint x="1480" y="365"/><di:waypoint x="1480" y="745"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="flow_resolve_export_di" bpmnElement="flow_resolve_export"><di:waypoint x="1310" y="810"/><di:waypoint x="1380" y="810"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="flow_export_exported_di" bpmnElement="flow_export_exported"><di:waypoint x="1580" y="810"/><di:waypoint x="1620" y="810"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="read_vendor_master_normalise_di" bpmnElement="read_vendor_master_normalise"><di:waypoint x="670" y="703"/><di:waypoint x="670" y="615"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="write_export_erp_file_di" bpmnElement="write_export_erp_file"><di:waypoint x="1480" y="875"/><di:waypoint x="1480" y="902"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>
